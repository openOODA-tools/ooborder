// # ooborder Frame Composition Engine
//
// Logline: Measures multiline text, computes alignments, and wraps contents in styled boxes.
//
// Setup: Pure geometric layout engine without external terminal dependencies or allocations.
//
// Beats:
//   1. Segment input text into individual lines and measure maximum column width.
//   2. Compose top and bottom border frames with optional title banners.
//   3. Apply horizontal and vertical margins and text alignments (left, center, right).

import "core/border_chars.oo";

pub fn repeat_str(s: String, count: Int) -> String {
    let mut out: String = "";
    let mut i: Int = 0;
    while i < count {
        out = out + s;
        i = i + 1;
    }
    return out;
}

fn split_lines(text: String) -> List[String] {
    let mut lines: List[String] = list_new();
    let n: Int = chars_len(text);
    let mut start: Int = 0;
    let mut i: Int = 0;

    while i < n {
        let c: String = char_at(text, i);
        if c == "\n" {
            let mut line: String = str_slice(text, start, i);
            if str_ends_with(line, "\r") {
                line = str_slice(line, 0, chars_len(line) - 1);
            }
            lines = list_push(lines, line);
            start = i + 1;
        }
        i = i + 1;
    }

    if start < n {
        lines = list_push(lines, str_slice(text, start, n));
    } else if n == 0 {
        lines = list_push(lines, "");
    }

    return lines;
}

fn pad_line(line: String, inner_w: Int, align: String) -> String {
    let w: Int = chars_len(line);
    let diff: Int = inner_w - w;
    if diff <= 0 {
        return line;
    }

    if align == "right" {
        return repeat_str(" ", diff) + line;
    }

    if align == "center" {
        let left: Int = diff / 2;
        let right: Int = diff - left;
        return repeat_str(" ", left) + line + repeat_str(" ", right);
    }

    return line + repeat_str(" ", diff);
}

pub fn render_box(
    text: String,
    style_name: String,
    title: String,
    pad_x: Int,
    pad_y: Int,
    align: String
) -> String {
    let style: BorderStyle = get_border_style(style_name);
    let lines: List[String] = split_lines(text);
    let num_lines: Int = list_len(lines);

    let mut max_w: Int = 0;
    let mut i: Int = 0;
    while i < num_lines {
        let l: String = list_get(lines, i);
        let len_l: Int = chars_len(l);
        if len_l > max_w {
            max_w = len_l;
        }
        i = i + 1;
    }

    let title_len: Int = chars_len(title);
    if title_len + 4 > max_w {
        max_w = title_len + 4;
    }

    let total_inner: Int = max_w + (pad_x * 2);

    let mut top_border: String = style.top_left;
    if title_len > 0 {
        let after_title: Int = total_inner - (title_len + 3);
        let right_pad: Int = if after_title > 0 { after_title } else { 1 };
        top_border = top_border + style.horiz + " " + title + " " + repeat_str(style.horiz, right_pad);
    } else {
        top_border = top_border + repeat_str(style.horiz, total_inner);
    }
    top_border = top_border + style.top_right;

    let bottom_border: String = style.bottom_left + repeat_str(style.horiz, total_inner) + style.bottom_right;

    let x_space: String = repeat_str(" ", pad_x);
    let empty_row: String = style.vert + repeat_str(" ", total_inner) + style.vert;

    let mut out: String = top_border;

    let mut py: Int = 0;
    while py < pad_y {
        out = out + "\n" + empty_row;
        py = py + 1;
    }

    let mut row_idx: Int = 0;
    while row_idx < num_lines {
        let l: String = list_get(lines, row_idx);
        let aligned_content: String = pad_line(l, max_w, align);
        let row: String = style.vert + x_space + aligned_content + x_space + style.vert;
        out = out + "\n" + row;
        row_idx = row_idx + 1;
    }

    py = 0;
    while py < pad_y {
        out = out + "\n" + empty_row;
        py = py + 1;
    }

    out = out + "\n" + bottom_border;
    return out;
}
