// # ooborder Model Context Protocol (MCP) Stdio Server
//
// Logline: JSON-RPC 2.0 stdio server providing panel border wrapping and styling tools.
//
// Setup: Demands FsReadCap for stream reading and stdio streaming. Zero ambient authority.
//
// Beats:
//   1. Ingest JSON-RPC 2.0 frames over stdin and dispatch RPC methods.
//   2. Advertise panel tools: border_wrap, border_styles, border_stats.
//   3. Execute capability-bounded text boxing and stream JSON responses.

import "core/box_builder.oo";
import "render/border_theme.oo";
import "ipc/json_field.oo";
import "ipc/border_opts.oo";

pub fn run_mcp_server(fs: &FsReadCap) {
    let mut running: Bool = true;
    while running {
        let line_res: Result[String, String] = oo_read_stdin_chunk(fs, 8192);
        if !line_res.is_ok() {
            running = false;
        } else {
            let line: String = match line_res { Ok(s) => s, Err(_) => "" };
            let trimmed: String = str_trim(line);
            if chars_len(trimmed) == 0 {
                running = false;
            } else {
                let id: String = json_get_field(trimmed, "id");
                let method: String = json_get_string(trimmed, "method");

                if method == "initialize" {
                    let resp: String = "{\"jsonrpc\":\"2.0\",\"id\":" + id +
                        ",\"result\":{\"protocolVersion\":\"2024-11-05\"," +
                        "\"serverInfo\":{\"name\":\"ooborder\",\"version\":\"0.2.0\"}," +
                        "\"capabilities\":{\"tools\":{}}}}";
                    println(resp);
                } else if method == "notifications/initialized" {
                    // Ack
                } else if method == "tools/list" {
                    let t1: String = "{\"name\":\"border_wrap\",\"description\":\"Wrap text inside decorative border frame with title\"," +
                        "\"inputSchema\":{\"type\":\"object\",\"properties\":{\"text\":{\"type\":\"string\"},\"style\":{\"type\":\"string\"},\"title\":{\"type\":\"string\"},\"padding\":{\"type\":\"integer\"},\"align\":{\"type\":\"string\"}},\"required\":[\"text\"]}}";
                    let t2: String = "{\"name\":\"border_styles\",\"description\":\"List available border frame styles and corner glyphs\"," +
                        "\"inputSchema\":{\"type\":\"object\",\"properties\":{}}}";
                    let t3: String = "{\"name\":\"border_stats\",\"description\":\"Query ooborder composition engine metadata\"," +
                        "\"inputSchema\":{\"type\":\"object\",\"properties\":{}}}";
                    let resp: String = "{\"jsonrpc\":\"2.0\",\"id\":" + id +
                        ",\"result\":{\"tools\":[" + t1 + "," + t2 + "," + t3 + "]}}";
                    println(resp);
                } else if method == "tools/call" {
                    let params: String = json_get_field(trimmed, "params");
                    let tool_name: String = json_get_string(params, "name");
                    let args: String = json_get_field(params, "arguments");

                    if tool_name == "border_wrap" {
                        let text_in: String = json_get_string(args, "text");
                        let style_in: String = json_get_string(args, "style");
                        let title_in: String = json_get_string(args, "title");
                        let p_str: String = json_get_field(args, "padding");
                        let align_in: String = json_get_string(args, "align");

                        let style: String = if chars_len(style_in) > 0 { style_in } else { "single" };
                        let pad: Int = if chars_len(p_str) > 0 { parse_int_str(p_str) } else { 1 };
                        let align: String = if chars_len(align_in) > 0 { align_in } else { "left" };

                        let boxed: String = render_box(text_in, style, title_in, pad, 0, align);
                        let j: String = render_box_json(text_in, json_escape_string(boxed), style, title_in);
                        let resp: String = "{\"jsonrpc\":\"2.0\",\"id\":" + id +
                            ",\"result\":{\"content\":[{\"type\":\"text\",\"text\":\"" + json_escape_string(j) + "\"}]}}";
                        println(resp);
                    } else if tool_name == "border_styles" {
                        let j: String = render_styles_list_json();
                        let resp: String = "{\"jsonrpc\":\"2.0\",\"id\":" + id +
                            ",\"result\":{\"content\":[{\"type\":\"text\",\"text\":\"" + json_escape_string(j) + "\"}]}}";
                        println(resp);
                    } else if tool_name == "border_stats" {
                        let j: String = "{\"engine\":\"ooborder\",\"version\":\"0.2.0\",\"pure_native\":true,\"styles\":[\"single\",\"double\",\"rounded\",\"thick\",\"ascii\",\"block\"]}";
                        let resp: String = "{\"jsonrpc\":\"2.0\",\"id\":" + id +
                            ",\"result\":{\"content\":[{\"type\":\"text\",\"text\":\"" + json_escape_string(j) + "\"}]}}";
                        println(resp);
                    } else {
                        let resp: String = "{\"jsonrpc\":\"2.0\",\"id\":" + id +
                            ",\"error\":{\"code\":-32601,\"message\":\"Method not found\"}}";
                        println(resp);
                    }
                } else {
                    let resp: String = "{\"jsonrpc\":\"2.0\",\"id\":" + id +
                        ",\"error\":{\"code\":-32601,\"message\":\"Method not found\"}}";
                    println(resp);
                }
            }
        }
    }
}
